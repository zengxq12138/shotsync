# shotsync deployment settings — copy to .env, fill in, then run `npm run setup`.
# Everything the deploy needs lives here; re-run `npm run setup` after edits.
# 复制为 .env 填好后运行 `npm run setup`；改完任何值再跑一次即可生效。

# ── Required / 必填 ────────────────────────────────────────────────

# Cloudflare account ID (Dashboard → any page's right sidebar, or `npx wrangler whoami`).
# Cloudflare 账户 ID（控制台右侧栏，或 `npx wrangler whoami`）
CLOUDFLARE_ACCOUNT_ID=

# Public URL of your deployed Worker — used to lock the R2 CORS rule to your origin.
# 部署后的 Worker 地址（用于限定 R2 CORS 来源），形如 https://shotsync.<你的子域>.workers.dev
WORKER_ORIGIN=

# Shared access token each device types in on first use. Leave empty and
# `npm run setup` generates one for you and saves it back here.
# 共享访问 token（每台设备首次打开时输入）。留空则 setup 自动生成并写回这里。
AUTH_TOKEN=

# ── Optional / 可选 ────────────────────────────────────────────────

# R2 bucket name (must match bucket_name in wrangler.toml; default shotsync).
# R2 桶名（与 wrangler.toml 的 bucket_name 一致；默认 shotsync）
R2_BUCKET=shotsync

# Per-bucket S3 endpoint, derived automatically from the account ID when empty.
# Leave empty unless R2's dashboard shows a different value.
# 每桶 S3 端点；留空会由账户 ID 自动推导，一般不用填。
R2_S3_ENDPOINT=

# ── Archive pool (optional) / 归档池（可选）────────────────────────
# Create an R2 API token first: Dashboard → R2 → Manage R2 API Tokens →
# Create API Token → Object Read & Write, scoped to only this bucket.
# 先建 R2 API token：控制台 → R2 → Manage R2 API Tokens → 权限 Object Read &
# Write、范围只勾本桶。两项都填后 `npm run setup` 会启用归档池。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
